# Copy to .env for local development. Placeholders only — never commit real values.

# --- Database (docker compose up -d postgres) ---
DATABASE_URL=postgres://friday:friday@localhost:5432/friday
DATABASE_SSL=false

# --- API ---
PORT=4000
WEB_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
OWNER_EMAIL=
ALLOW_REGISTRATION=true
# Demo mode: rule-based assistant + demo account, no AI keys needed.
DEMO_MODE=true

# --- AI providers (server-side only; leave blank to disable) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_USD_PER_MTOK=0
OPENAI_OUTPUT_USD_PER_MTOK=0
MOONSHOT_API_KEY=
MOONSHOT_MODEL=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
AI_GLOBAL_MONTHLY_BUDGET_USD=20

# --- Mira's natural voice (server text-to-speech; needs OPENAI_API_KEY) ---
MIRA_VOICE_ENABLED=true
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
OPENAI_TTS_USD_PER_MCHAR=0

# --- Optional OpenClaw (disabled by default; see docs/OPENCLAW.md) ---
OPENCLAW_ENABLED=false
OPENCLAW_URL=
OPENCLAW_TOKEN=

# --- Push (Expo Push Service → APNs) ---
# Run migrations + the scheduler inside the API (single-service deploys). Set false if you run a worker / pre-deploy step.
AUTO_MIGRATE=true
EMBEDDED_WORKER=true

PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# --- Web ---
API_INTERNAL_URL=http://localhost:4000
